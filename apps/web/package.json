{
  "name": "@iem-cast/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run build:admin && npm run build:musician",
    "build:admin": "vite build --config vite.admin.config.ts",
    "build:musician": "vite build --config vite.musician.config.ts",
    "build:site": "vite build --config vite.site.config.ts",
    "dev:admin": "vite --config vite.admin.config.ts",
    "dev:site": "vite --config vite.site.config.ts",
    "preview:site": "vite preview --config vite.site.config.ts --port 4173 --strictPort"
  },
  "dependencies": {
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
